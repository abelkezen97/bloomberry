---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = 'Luxury hampers, premium flowers, and bespoke gifting experiences in the UAE. Same-day delivery in Dubai & Abu Dhabi. Personalized corporate & wedding gifting.',
  canonical = 'https://bloomandberry.ae'
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#FFF7F2" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="/images/eidhero.png" />
  <meta property="og:locale" content="en_AE" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- Critical Above-the-Fold LCP Image Preloads -->
  <link rel="preload" href="/images/mobileheroeid.png" as="image" media="(max-width: 767px)" fetchpriority="high" />
  <link rel="preload" href="/images/eidhero.png" as="image" media="(min-width: 768px)" fetchpriority="high" />

  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/images/Rosegoldlogo.svg" />

  <title>{title}</title>

  <!-- Structured Data Graph (Organization, WebSite & LocalBusiness) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://bloomberry.ae/#organization",
        "name": "Bloom & Berry",
        "url": "https://bloomberry.ae",
        "logo": {
          "@type": "ImageObject",
          "@id": "https://bloomberry.ae/#logo",
          "url": "https://bloomberry.ae/images/Rosegoldlogo.svg",
          "caption": "Bloom & Berry Logo"
        },
        "sameAs": [
          "https://instagram.com",
          "https://facebook.com",
          "https://pinterest.com"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "https://bloomberry.ae/#website",
        "url": "https://bloomberry.ae",
        "name": "Bloom & Berry",
        "publisher": {
          "@id": "https://bloomberry.ae/#organization"
        }
      },
      {
        "@type": "FloristShop",
        "@id": "https://bloomberry.ae/#localbusiness",
        "name": "Bloom & Berry",
        "description": "Premium luxury hampers, custom flower bouquets, corporate gifting suites, and wedding styling in Dubai and across the UAE.",
        "url": "https://bloomberry.ae",
        "telephone": "+971-55-367-0255",
        "priceRange": "$$$",
        "image": "https://bloomberry.ae/images/eidhero.png",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Luxury Gifting Suite, Downtown Dubai",
          "addressLocality": "Dubai",
          "addressRegion": "Dubai",
          "addressCountry": "AE"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "25.2048",
          "longitude": "55.2708"
        },
        "areaServed": [
          { "@type": "AdministrativeArea", "name": "Dubai" },
          { "@type": "AdministrativeArea", "name": "Abu Dhabi" },
          { "@type": "AdministrativeArea", "name": "Sharjah" },
          { "@type": "AdministrativeArea", "name": "Ajman" },
          { "@type": "AdministrativeArea", "name": "United Arab Emirates" }
        ],
        "parentOrganization": {
          "@id": "https://bloomberry.ae/#organization"
        }
      }
    ]
  })} />
</head>
<body class="min-h-screen bg-ivory text-deep antialiased">
  <slot />

  <!-- Intersection Observer for Reveal Animations -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    });
  </script>

  <!-- Vercel Web Analytics integration -->
  <script>
    import { inject } from '@vercel/analytics';
    inject();
  </script>
</body>
</html>
