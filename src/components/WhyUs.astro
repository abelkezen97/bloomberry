---
const badges = [
  {
    icon: 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z',
    title: 'PREMIUM QUALITY',
    desc: 'Finest blooms & gifts'
  },
  {
    icon: 'M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.079-.504 1.005-1.12l-1.105-9.258A1.683 1.683 0 0018.508 7.5H5.25V7.5z',
    title: 'SAME DAY DELIVERY',
    desc: 'Order by 2PM'
  },
  {
    icon: 'M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18',
    title: 'BEAUTIFULLY PACKAGED',
    desc: 'Gift-ready & elegant'
  },
  {
    icon: 'M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z',
    title: 'PERSONALIZED TOUCH',
    desc: 'Add a custom note'
  }
];
---
<section class="w-full bg-[#FEF9F6] border-y border-gray-100/80 py-8 sm:py-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-4 divide-y divide-gray-100 md:divide-y-0 md:divide-x divide-solid">
      {badges.map((b, idx) => (
        <div class={`flex flex-row items-center gap-3.5 justify-center px-2 ${idx > 1 ? 'pt-4 md:pt-0' : ''} ${idx % 2 !== 0 ? 'ps-4 md:ps-0' : ''}`}>
          <!-- Outlined Rose Gold Icon -->
          <div class="text-[#BF866E] flex-shrink-0">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
              <path stroke-linecap="round" stroke-linejoin="round" d={b.icon} />
            </svg>
          </div>
          <!-- Text -->
          <div class="text-left">
            <h4 class="font-body text-[10px] sm:text-xs font-semibold tracking-wider text-[#3D2E27]">
              {b.title}
            </h4>
            <p class="font-body text-[9px] sm:text-[10px] text-gray-500 mt-0.5 font-light">
              {b.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
