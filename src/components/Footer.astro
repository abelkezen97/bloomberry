---
const shopLinks = [
  { label: 'All Products', href: '/collections/all' },
  { label: 'Flowers', href: '/collections/flowers' },
  { label: 'Gifts', href: '/collections/gifts' },
  { label: 'Hampers', href: '/collections/hampers' },
  { label: 'Occasions', href: '/collections/occasions' },
  { label: 'Corporate', href: '/collections/corporate' }
];

const helpLinks = [
  { label: 'Delivery Information', href: '/delivery' },
  { label: 'Returns & Refunds', href: '/returns' },
  { label: 'FAQs', href: '/faq' },
  { label: 'Contact Us', href: '/contact' },
  { label: 'Track My Order', href: '/track' }
];
---
<footer class="w-full bg-[#FEF9F6] border-t border-gray-100/80 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Top 4-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8 mb-16">
      
      <!-- Column 1: About -->
      <div class="flex flex-col text-left">
        <h3 class="font-body text-xs font-semibold tracking-[0.18em] text-[#3D2E27] uppercase mb-5">
          ABOUT BLOOM & BERRY
        </h3>
        <p class="font-body font-normal text-xs sm:text-sm text-gray-700 leading-relaxed max-w-xs mb-6">
          We curate premium flowers and luxury gifts that make every moment unforgettable.
        </p>
        <!-- Social Icons -->
        <div class="flex items-center gap-4">
          <a href="https://instagram.com" target="_blank" rel="noopener" class="text-gray-600 hover:text-[#BF866E] transition-colors" aria-label="Instagram">
            <svg class="w-4.5 h-4.5 fill-none stroke-current" stroke-width="1.5" viewBox="0 0 24 24">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37zM17.5 6.5h.01" />
            </svg>
          </a>
          <a href="https://facebook.com" target="_blank" rel="noopener" class="text-gray-600 hover:text-[#BF866E] transition-colors" aria-label="Facebook">
            <svg class="w-4.5 h-4.5 fill-none stroke-current" stroke-width="1.5" viewBox="0 0 24 24">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
            </svg>
          </a>
          <a href="https://pinterest.com" target="_blank" rel="noopener" class="text-gray-600 hover:text-[#BF866E] transition-colors" aria-label="Pinterest">
            <svg class="w-4.5 h-4.5 fill-none stroke-current" stroke-width="1.5" viewBox="0 0 24 24">
              <path d="M8 22a9 9 0 0 1-5.36-1.64c.24-1.63.63-3.07 1-4.48L5 10c-.72-2.3.43-5.26 2.5-5.26 1.44 0 2 1 2 2.5 0 2.21-1.32 4.14-1.32 6.13 0 1.25.75 2.13 2 2.13 3.65 0 6.5-3.32 6.5-7.5C16.68 4.27 13.5 2 9.5 2a8.31 8.31 0 0 0-8.5 8.5c0 2.53 1.23 4.24 3 5 0 .21.12.21.05.47-.13.56-.37 1.48-.48 2a.23.23 0 0 1-.22.18c-3.13-.76-4.52-4-4.52-7.15A11.39 11.39 0 0 1 10.75 0c5.31 0 8.75 3.39 8.75 8 0 5.43-3.69 9.5-8.5 9.5-1.5 0-3-1-3.5-2l-1 4z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Shop Links -->
      <div class="flex flex-col text-left">
        <h3 class="font-body text-xs font-semibold tracking-[0.18em] text-[#3D2E27] uppercase mb-5">
          SHOP
        </h3>
        <ul class="space-y-3.5">
          {shopLinks.map(link => (
            <li>
              <a href={link.href} class="font-body text-xs sm:text-sm text-gray-700 hover:text-[#BF866E] transition-colors font-normal">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Help Links -->
      <div class="flex flex-col text-left">
        <h3 class="font-body text-xs font-semibold tracking-[0.18em] text-[#3D2E27] uppercase mb-5">
          HELP
        </h3>
        <ul class="space-y-3.5">
          {helpLinks.map(link => (
            <li>
              <a href={link.href} class="font-body text-xs sm:text-sm text-gray-700 hover:text-[#BF866E] transition-colors font-normal">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Newsletter -->
      <div class="flex flex-col text-left">
        <h3 class="font-body text-xs font-semibold tracking-[0.18em] text-[#3D2E27] uppercase mb-5">
          NEWSLETTER
        </h3>
        <p class="font-body font-normal text-xs sm:text-sm text-gray-700 leading-relaxed mb-6">
          Stay updated with our latest collections and exclusive offers.
        </p>
        <!-- Newsletter Input Box matching mock exactly -->
        <form class="w-full max-w-sm flex items-center bg-white border border-gray-200 focus-within:border-[#BF866E] transition-colors rounded-sm overflow-hidden px-3.5 py-1">
          <input 
            type="email" 
            placeholder="Enter your email" 
            class="w-full bg-transparent border-0 focus:outline-none text-xs font-body tracking-wider text-gray-700 placeholder-gray-400 py-2.5 focus:ring-0" 
            required 
          />
          <button type="submit" class="text-gray-600 hover:text-[#BF866E] transition-colors px-1" aria-label="Subscribe">
            <span class="text-base font-light font-body transition-colors">&gt;</span>
          </button>
        </form>
      </div>

    </div>

    <!-- Divider -->
    <div class="border-t border-gray-100 mb-8"></div>

    <!-- Bottom Center Bar -->
    <div class="text-center">
      <p class="font-body text-[10px] sm:text-xs text-gray-600 font-normal tracking-wide">
        © 2024 Bloom & Berry. All rights reserved.
      </p>
    </div>
  </div>
</footer>
