---
const wa = '971553670255';

const festiveProducts = [
  {
    id: 'royal-diwali-gold-hamper',
    title: 'The Royal Diwali Gold Hamper',
    price: 'AED 890',
    image: '/images/festive_diwali_hamper.png',
    tagline: 'An opulent golden tribute for the Festival of Lights.',
    rating: 5,
    reviews: 36
  },
  {
    id: 'imperial-shubh-bandhan-box',
    title: 'The Imperial Shubh Bandhan Box',
    price: 'AED 620',
    image: '/images/festive_rakhi_hamper.png',
    tagline: 'Celebrate eternal sibling bonds with handcrafted gold-leaf mithai.',
    rating: 5,
    reviews: 24
  }
];
---
<section id="festive-showcase" class="w-full bg-[#FEF9F6] py-16 sm:py-20 lg:py-24 border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Centered Editorial Header -->
    <div class="text-center mb-12 sm:mb-16">
      <span class="text-[9px] tracking-[0.25em] uppercase font-body text-[#BF866E] font-semibold block mb-2">Festive Curation</span>
      <h2 class="font-heading text-xl sm:text-2xl lg:text-3xl tracking-[0.2em] text-[#3D2E27] uppercase font-medium">
        North Indian Festivals
      </h2>
      <p class="font-body font-normal text-xs sm:text-sm text-gray-700 max-w-md mx-auto mt-4 leading-relaxed">
        Luxurious gifting hampers meticulously hand-assembled for Diwali, Rakhi, Karwa Chauth, and majestic traditional celebrations.
      </p>
    </div>

    <!-- Festive Grid (2 columns on mobile/desktop for majestic sizing) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 max-w-5xl mx-auto">
      {festiveProducts.map(p => {
        const orderMsg = encodeURIComponent(`Hi Bloom & Berry, I would like to order the "${p.title}" (${p.price}) from your Indian Festive Showcase. Can we coordinate delivery?`);
        return (
          <div class="group flex flex-col bg-white p-4 rounded-sm shadow-[0_4px_24px_rgba(0,0,0,0.015)] border border-gray-100/50">
            <!-- Large Image Container -->
            <div class="relative overflow-hidden aspect-square bg-gray-50 rounded-sm mb-5">
              <a href={`/products/${p.id}`}>
                <img 
                  src={p.image} 
                  alt={p.title} 
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-102" 
                  loading="lazy" 
                />
              </a>
              <span class="absolute top-4 left-4 bg-[#FAF4EF] text-gray-800 text-[8px] tracking-[0.2em] uppercase font-body px-3.5 py-2 border border-gray-100 rounded-sm font-semibold">
                ROYAL FESTIVE SUITE
              </span>
            </div>

            <!-- Content details -->
            <div class="flex-1 flex flex-col">
              <h3 class="font-heading text-lg sm:text-xl text-[#3D2E27] hover:text-[#BF866E] transition-colors line-clamp-1">
                <a href={`/products/${p.id}`}>{p.title}</a>
              </h3>
              
              <p class="font-heading italic text-xs text-[#BF866E] mt-1.5 line-clamp-1 mb-3">
                "{p.tagline}"
              </p>

              <!-- Star Rating & Price Line -->
              <div class="flex items-center justify-between mt-auto pt-3 border-t border-gray-50 mb-5">
                <span class="font-body text-sm sm:text-base font-semibold text-gray-800">
                  {p.price}
                </span>

                <div class="flex items-center gap-1">
                  <div class="flex text-[#BF866E] gap-0.5">
                    {[...Array(p.rating)].map(() => (
                      <svg class="w-3 h-3 fill-current" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                    ))}
                  </div>
                  <span class="font-body text-[9px] text-gray-600 font-normal">({p.reviews})</span>
                </div>
              </div>

              <!-- Button Stack -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-auto">
                <a 
                  href={`https://wa.me/${wa}?text=${orderMsg}`} 
                  target="_blank" 
                  rel="noopener"
                  class="inline-flex items-center justify-center bg-[#BF866E] hover:bg-[#A8684F] text-white text-[9px] font-body tracking-[0.1em] uppercase py-3 transition-colors duration-300 rounded-sm font-semibold whitespace-nowrap px-1"
                >
                  ORDER VIA WHATSAPP
                </a>
                
                <a 
                  href={`/products/${p.id}`}
                  class="inline-flex items-center justify-center border border-gray-100 hover:border-gray-300 text-gray-700 hover:text-gray-900 text-[9px] font-body tracking-[0.1em] uppercase py-3 transition-all duration-300 rounded-sm bg-white whitespace-nowrap px-1"
                >
                  VIEW DETAILS
                </a>
              </div>

            </div>

          </div>
        );
      })}
    </div>

  </div>
</section>
