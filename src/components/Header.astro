---
const leftLinks = [
  { label: 'Shop All', href: '/collections/all' },
  { label: 'Flowers', href: '/collections/flowers' },
  { label: 'Gifts', href: '/collections/gifts' },
  { label: 'Hampers', href: '/collections/hampers' },
];

const rightLinks = [
  { label: 'Occasions', href: '/collections/occasions' },
  { label: 'Corporate', href: '/collections/corporate' },
  { label: 'About Us', href: '/about' },
];

// Combine all links for the mobile menu overlay
const navLinks = [...leftLinks, ...rightLinks];

const whatsappNumber = '971553670255';
const whatsappMessage = encodeURIComponent("Hi Bloom & Berry, I'd like to learn more about your premium luxury gifting services.");
---

<!-- Dismissible Announcement Bar -->
<div id="announcement-bar" class="w-full bg-[#BF866E] text-white text-[9px] sm:text-[10px] tracking-[0.2em] font-body py-2.5 px-4 relative flex items-center justify-center text-center">
  <span>COMPLIMENTARY DELIVERY ON ALL ORDERS OVER AED 350</span>
  <button id="close-announcement" class="absolute right-4 hover:opacity-80 focus:outline-none text-white/90 text-sm font-light" aria-label="Dismiss">✕</button>
</div>

<header id="site-header" class="w-full bg-white border-b border-gray-100 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- DESKTOP SPLIT NAV ROW (Logo Centered Symmetrically in the Middle) -->
    <div class="hidden md:grid grid-cols-[1fr_auto_1fr] items-center py-5 lg:py-6 gap-6 lg:gap-8 w-full">
      
      <!-- Left Navigation links (aligned to the right, sitting close to the logo) -->
      <nav class="flex justify-end items-center gap-7 lg:gap-10" aria-label="Desktop navigation left">
        {leftLinks.map(link => (
          <a 
            href={link.href} 
            class="text-[10px] lg:text-[11px] font-body font-light tracking-[0.22em] uppercase text-gray-800 hover:text-[#BF866E] transition-colors duration-300 relative group py-1"
          >
            {link.label}
            <span class="absolute bottom-0 left-0 w-full h-[1px] bg-[#BF866E] scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></span>
          </a>
        ))}
      </nav>

      <!-- Center Logo -->
      <a href="/" class="flex flex-col items-center justify-self-center px-4 lg:px-8">
        <img 
          src="/images/Rosegoldlogo.svg" 
          alt="Bloom & Berry" 
          class="h-16 lg:h-20 w-auto object-contain transition-transform duration-300 hover:scale-102"
        />
      </a>

      <!-- Right Navigation links (aligned to the left, sitting close to the logo) -->
      <nav class="flex justify-start items-center gap-7 lg:gap-10" aria-label="Desktop navigation right">
        {rightLinks.map(link => (
          <a 
            href={link.href} 
            class="text-[10px] lg:text-[11px] font-body font-light tracking-[0.22em] uppercase text-gray-800 hover:text-[#BF866E] transition-colors duration-300 relative group py-1"
          >
            {link.label}
            <span class="absolute bottom-0 left-0 w-full h-[1px] bg-[#BF866E] scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></span>
          </a>
        ))}
      </nav>

    </div>

    <!-- MOBILE HEADER ROW (Centered Mobile Logo with Right Hamburger Menu) -->
    <div class="md:hidden flex items-center justify-between py-4">
      <!-- Left Spacer for Perfect Symmetry -->
      <div class="w-10"></div>
      
      <!-- Center Mobile Logo -->
      <a href="/" class="flex items-center justify-center">
        <img 
          src="/images/Rosegoldlogo.svg" 
          alt="Bloom & Berry" 
          class="h-[4.5rem] w-auto object-contain"
        />
      </a>
      
      <!-- Right Mobile Hamburger Toggle -->
      <button 
        id="menu-toggle" 
        class="w-10 h-10 flex items-center justify-center text-gray-700 focus:outline-none hover:text-[#BF866E] transition-colors" 
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Full-Screen Menu Overlay -->
  <div id="mobile-menu" class="fixed inset-0 bg-white z-40 flex flex-col opacity-0 pointer-events-none transition-opacity duration-300 md:hidden">
    <div class="flex-1 flex flex-col justify-center px-8 pt-20 pb-10 relative">
      
      <!-- Minimalist Brand Header in Overlay -->
      <div class="absolute top-6 left-1/2 -translate-x-1/2">
        <img src="/images/Rosegoldlogo.svg" alt="Bloom & Berry" class="h-12 w-auto object-contain" />
      </div>

      <!-- Elegant Close Button in Overlay -->
      <button 
        id="menu-close" 
        class="absolute top-6 right-6 p-2 text-gray-700 hover:text-[#BF866E] focus:outline-none transition-colors" 
        aria-label="Close menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <nav class="space-y-4 text-center" aria-label="Mobile navigation">
        {navLinks.map((link, i) => (
          <a href={link.href}
             class="mobile-nav-link block py-3.5 font-heading text-2xl text-gray-800 hover:text-[#BF866E] transition-all duration-300 translate-y-6 opacity-0"
             style={`transition-delay: ${i * 40}ms`}>
            {link.label}
          </a>
        ))}
      </nav>

      <div class="mt-12 pt-8 border-t border-gray-100 flex flex-col items-center">
        <a href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`}
           target="_blank" rel="noopener"
           class="inline-flex items-center justify-center bg-[#BF866E] text-white px-8 py-3.5 rounded-sm text-xs font-body tracking-[0.2em] uppercase hover:bg-[#A8684F] transition-colors w-full max-w-xs">
          WhatsApp Concierge
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const announcementBar = document.getElementById('announcement-bar');
  const closeAnnouncement = document.getElementById('close-announcement');
  const menuToggle = document.getElementById('menu-toggle');
  const menuClose = document.getElementById('menu-close');
  const mobileMenu = document.getElementById('mobile-menu');

  // Dismiss Announcement Bar
  closeAnnouncement?.addEventListener('click', () => {
    announcementBar?.classList.add('hidden');
  });

  // Open overlay function
  const openOverlay = () => {
    mobileMenu?.classList.remove('opacity-0', 'pointer-events-none');
    mobileMenu?.classList.add('opacity-100');
    document.body.style.overflow = 'hidden';
    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      (link as HTMLElement).style.transform = 'translateY(0)';
      (link as HTMLElement).style.opacity = '1';
    });
  };

  // Close overlay function
  const closeOverlay = () => {
    mobileMenu?.classList.add('opacity-0', 'pointer-events-none');
    mobileMenu?.classList.remove('opacity-100');
    document.body.style.overflow = '';
    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      (link as HTMLElement).style.transform = 'translateY(24px)';
      (link as HTMLElement).style.opacity = '0';
    });
  };

  // Register Event Listeners
  menuToggle?.addEventListener('click', openOverlay);
  menuClose?.addEventListener('click', closeOverlay);
</script>
