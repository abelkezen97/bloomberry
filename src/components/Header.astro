---
const navLinks = [
  { label: 'Shop All', href: '/collections/all' },
  { label: 'Flowers', href: '/collections/flowers' },
  { label: 'Gifts', href: '/collections/gifts' },
  { label: 'Hampers', href: '/collections/hampers' },
  { label: 'Occasions', href: '/collections/occasions' },
  { label: 'Corporate', href: '/collections/corporate' },
  { label: 'About Us', href: '/about' },
];

const whatsappNumber = '971501234567';
const whatsappMessage = encodeURIComponent("Hi Bloom & Berry, I'd like to learn more about your premium luxury gifting services.");
---

<!-- Dismissible Announcement Bar -->
<div id="announcement-bar" class="w-full bg-[#BF866E] text-white text-[9px] sm:text-[10px] tracking-[0.2em] font-body py-2.5 px-4 relative flex items-center justify-center text-center">
  <span>COMPLIMENTARY DELIVERY ON ALL ORDERS OVER $100</span>
  <button id="close-announcement" class="absolute right-4 hover:opacity-80 focus:outline-none text-white/90 text-sm font-light" aria-label="Dismiss">✕</button>
</div>

<header id="site-header" class="w-full bg-white border-b border-gray-100 transition-all duration-300">
  <!-- Desktop Header Layout (Exact Match) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between py-5 border-b border-gray-50">
      <!-- Search Input (Left) -->
      <div class="flex-1 hidden md:flex items-center max-w-xs relative">
        <svg class="w-4 h-4 text-gray-400 absolute left-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
        </svg>
        <input 
          type="text" 
          placeholder="Search" 
          class="w-full pl-9 pr-4 py-1.5 bg-transparent border-b border-transparent hover:border-gray-200 focus:border-[#BF866E] focus:outline-none text-xs font-body tracking-wider text-gray-600 placeholder-gray-400 transition-colors"
        />
      </div>

      <!-- Hamburger (Mobile Left) -->
      <button id="menu-toggle" class="md:hidden p-2 text-gray-700" aria-label="Toggle menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>

      <!-- Center Logo (SVG Custom Image) -->
      <a href="/" class="flex flex-col items-center py-1">
        <img src="/images/Rosegoldlogo.svg" alt="Bloom & Berry" class="h-16 md:h-20 w-auto object-contain" />
      </a>

      <!-- Right Actions (User & Bag/WhatsApp) -->
      <div class="flex-1 flex items-center justify-end gap-4 md:gap-5">
        <!-- Account -->
        <a href="#account" class="text-gray-700 hover:text-[#BF866E] transition-colors" aria-label="Account">
          <svg class="w-5.5 h-5.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
        </a>

        <!-- Shopping Bag / WhatsApp Concierge Direct Link -->
        <a href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`} target="_blank" rel="noopener" class="text-gray-700 hover:text-[#BF866E] transition-colors relative" aria-label="Cart / WhatsApp Gifting Inquiry">
          <svg class="w-5.5 h-5.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
          </svg>
          <!-- Elegant soft dot representing live concierge status -->
          <span class="absolute top-0 right-0 w-2 h-2 bg-[#BF866E] rounded-full animate-ping"></span>
        </a>
      </div>
    </div>

    <!-- Navigation Links Row -->
    <nav class="hidden md:flex justify-center items-center gap-9 py-4" aria-label="Desktop navigation">
      {navLinks.map(link => (
        <a href={link.href} class="text-[11px] font-body font-normal tracking-[0.18em] uppercase text-gray-600 hover:text-[#BF866E] transition-colors duration-300">
          {link.label}
        </a>
      ))}
    </nav>
  </div>

  <!-- Mobile Full-Screen Menu Overlay -->
  <div id="mobile-menu" class="fixed inset-0 bg-white z-40 flex flex-col opacity-0 pointer-events-none transition-opacity duration-300 md:hidden">
    <div class="flex-1 flex flex-col justify-center px-8 pt-20 pb-10">
      <nav class="space-y-2" aria-label="Mobile navigation">
        {navLinks.map((link, i) => (
          <a href={link.href}
             class="mobile-nav-link block py-3 font-heading text-2xl text-gray-800 hover:text-[#BF866E] transition-all duration-300 translate-y-6 opacity-0"
             style={`transition-delay: ${i * 50}ms`}>
            {link.label}
          </a>
        ))}
      </nav>

      <div class="mt-10 pt-8 border-t border-gray-100">
        <a href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`}
           target="_blank" rel="noopener"
           class="inline-flex items-center gap-3 bg-[#BF866E] text-white px-6 py-3 rounded-full text-xs font-body tracking-wider uppercase hover:opacity-90 transition-colors">
          WhatsApp Concierge
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const announcementBar = document.getElementById('announcement-bar');
  const closeAnnouncement = document.getElementById('close-announcement');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  let isOpen = false;

  // Dismiss Announcement Bar
  closeAnnouncement?.addEventListener('click', () => {
    announcementBar?.classList.add('hidden');
  });

  // Mobile menu toggle
  menuToggle?.addEventListener('click', () => {
    isOpen = !isOpen;
    if (isOpen) {
      mobileMenu?.classList.remove('opacity-0', 'pointer-events-none');
      mobileMenu?.classList.add('opacity-100');
      document.body.style.overflow = 'hidden';
      document.querySelectorAll('.mobile-nav-link').forEach(link => {
        (link as HTMLElement).style.transform = 'translateY(0)';
        (link as HTMLElement).style.opacity = '1';
      });
    } else {
      mobileMenu?.classList.add('opacity-0', 'pointer-events-none');
      mobileMenu?.classList.remove('opacity-100');
      document.body.style.overflow = '';
      document.querySelectorAll('.mobile-nav-link').forEach(link => {
        (link as HTMLElement).style.transform = 'translateY(24px)';
        (link as HTMLElement).style.opacity = '0';
      });
    }
  });
</script>
