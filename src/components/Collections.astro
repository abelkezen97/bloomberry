---
const collections = [
  {
    title: 'FLOWERS',
    image: '/images/flowers.png',
    link: '/collections/flowers'
  },
  {
    title: 'GIFTS',
    image: '/images/personalized.png',
    link: '/collections/gifts'
  },
  {
    title: 'HAMPERS',
    image: '/images/hampers.png',
    link: '/collections/hampers'
  },
  {
    title: 'CORPORATE',
    image: '/images/corporate.png',
    link: '/collections/corporate'
  }
];

const wa = '971501234567';
---
<section id="collections" class="w-full bg-white py-16 sm:py-20 lg:py-24 border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Centered Header matching mockup exactly -->
    <div class="text-center mb-12 sm:mb-16">
      <h2 class="font-heading text-xl sm:text-2xl tracking-[0.2em] text-[#3D2E27] uppercase font-medium">
        SHOP OUR COLLECTIONS
      </h2>
    </div>

    <!-- 4-Column Grid matching mockup -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10 sm:gap-x-8">
      {collections.map(c => {
        const msg = encodeURIComponent(`Hi Bloom & Berry, I am interested in exploring your ${c.title} collection.`);
        return (
          <div class="group flex flex-col text-center">
            <!-- Image with smooth hover effect -->
            <div class="relative overflow-hidden aspect-[4/5] bg-gray-50 mb-5 rounded-sm">
              <a href={c.link}>
                <img 
                  src={c.image} 
                  alt={c.title} 
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" 
                  loading="lazy" 
                />
              </a>
            </div>
            <!-- Title -->
            <h3 class="font-body text-xs sm:text-sm font-semibold tracking-[0.18em] text-[#3D2E27] uppercase mb-1">
              {c.title}
            </h3>
            <!-- Link -->
            <a 
              href={c.link}
              class="font-body text-[10px] sm:text-xs font-semibold tracking-wider text-[#BF866E] hover:text-[#A8684F] transition-colors mt-1 inline-flex items-center justify-center gap-1"
            >
              SHOP NOW <span class="text-xs">→</span>
            </a>
          </div>
        );
      })}
    </div>
  </div>
</section>
