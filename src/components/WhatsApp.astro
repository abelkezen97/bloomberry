---
const wa = '971553670255';
const msg = encodeURIComponent("Hi Bloom & Berry, I'd like to place an order.");
---
<!-- Floating WhatsApp Button (Desktop) -->
<a href={`https://wa.me/${wa}?text=${msg}`} target="_blank" rel="noopener"
   id="floating-wa"
   class="hidden sm:flex fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-whatsapp hover:bg-whatsapp-dark text-white items-center justify-center shadow-lg shadow-whatsapp/30 wa-pulse transition-all hover:scale-110"
   aria-label="Chat on WhatsApp">
  <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
    <path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.75.75 0 00.917.917l4.458-1.495A11.952 11.952 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-2.325 0-4.47-.744-6.227-2.01l-.345-.26-3.578 1.199 1.199-3.578-.26-.345A9.955 9.955 0 012 12c0-5.514 4.486-10 10-10s10 4.486 10 10-4.486 10-10 10z"/>
  </svg>
</a>

<!-- Sticky Mobile Bottom CTA -->
<div id="mobile-sticky-cta" class="sm:hidden fixed bottom-0 left-0 right-0 z-50 glass-effect border-t border-champagne/30 px-4 py-3 safe-area-pb opacity-0 translate-y-full transition-all duration-500">
  <a href={`https://wa.me/${wa}?text=${msg}`} target="_blank" rel="noopener"
     class="flex items-center justify-center gap-2.5 bg-whatsapp hover:bg-whatsapp-dark text-white w-full py-3.5 rounded-full text-sm font-body font-medium tracking-wide transition-colors">
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
      <path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.75.75 0 00.917.917l4.458-1.495A11.952 11.952 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-2.325 0-4.47-.744-6.227-2.01l-.345-.26-3.578 1.199 1.199-3.578-.26-.345A9.955 9.955 0 012 12c0-5.514 4.486-10 10-10s10 4.486 10 10-4.486 10-10 10z"/>
    </svg>
    Chat on WhatsApp
  </a>
</div>

<style>
  .safe-area-pb { padding-bottom: max(0.75rem, env(safe-area-inset-bottom)); }
</style>

<script>
  const stickyCta = document.getElementById('mobile-sticky-cta');
  let ctaShown = false;
  window.addEventListener('scroll', () => {
    if (window.scrollY > 600 && !ctaShown) {
      stickyCta?.classList.remove('opacity-0', 'translate-y-full');
      stickyCta?.classList.add('opacity-100', 'translate-y-0');
      ctaShown = true;
    } else if (window.scrollY <= 600 && ctaShown) {
      stickyCta?.classList.add('opacity-0', 'translate-y-full');
      stickyCta?.classList.remove('opacity-100', 'translate-y-0');
      ctaShown = false;
    }
  }, { passive: true });
</script>
