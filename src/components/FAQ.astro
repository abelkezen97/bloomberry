---
const faqs = [
  { q: 'Do you offer same-day delivery in Dubai and Abu Dhabi?', a: 'Yes! We offer same-day delivery across Dubai, Abu Dhabi, Sharjah, and other UAE emirates. Orders placed before 2 PM are eligible for same-day delivery. Contact us on WhatsApp for urgent requests.' },
  { q: 'Can I customize my luxury hamper or gift box?', a: 'Absolutely! Customization is at the heart of what we do. From selecting specific items to adding personalized messages, monograms, and custom packaging — we create bespoke gifting experiences tailored to your preferences.' },
  { q: 'How do I place an order with Bloom & Berry?', a: 'Simply browse our collections, select your desired gift, and tap "Order via WhatsApp." Our gifting concierge will guide you through the process, confirm details, and arrange delivery — all through WhatsApp.' },
  { q: 'Do you provide corporate gifting for large orders?', a: 'Yes, we specialize in corporate gifting programs for companies of all sizes. We offer bulk ordering, custom branding, dedicated account management, and UAE-wide delivery logistics. Contact us for a corporate catalogue.' },
  { q: 'What occasions do you cater to?', a: 'We cater to every occasion — birthdays, anniversaries, weddings, baby showers, Eid, Ramadan, corporate events, congratulations, thank you gifts, and more. Each gift is thoughtfully curated for the occasion.' },
  { q: 'How fresh are your flowers?', a: 'We source our flowers from the finest farms worldwide and arrange them fresh daily. Our expert florists ensure every bouquet is crafted with the freshest, most premium blooms available. We guarantee 5-7 days of freshness.' },
  { q: 'What areas do you deliver to in the UAE?', a: 'We deliver across the entire UAE including Dubai, Abu Dhabi, Sharjah, Ajman, Ras Al Khaimah, Fujairah, and Umm Al Quwain. Delivery timelines may vary by emirate.' },
  { q: 'Can I include a personalized message with my gift?', a: 'Of course! Every gift can include a handwritten or printed personalized message card. Simply share your message with our WhatsApp concierge and we will beautifully incorporate it into your gift presentation.' },
];
---
<section id="faq" class="py-16 sm:py-24 lg:py-32 bg-champagne/15">
  <div class="max-w-3xl mx-auto px-5 sm:px-8">
    <div class="text-center mb-12 sm:mb-16 reveal">
      <p class="text-[10px] sm:text-xs tracking-[0.3em] uppercase font-body text-rose-gold mb-3">Common Questions</p>
      <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl text-deep">Frequently <span class="italic text-rose-gold">Asked</span></h2>
    </div>
    <div class="space-y-3 reveal" id="faq-list">
      {faqs.map((f, i) => (
        <div class="faq-item bg-white rounded-xl luxury-shadow overflow-hidden" data-faq={i}>
          <button class="faq-toggle w-full flex items-center justify-between p-5 sm:p-6 text-left" aria-expanded="false">
            <h3 class="font-heading text-sm sm:text-base text-deep pr-4">{f.q}</h3>
            <span class="accordion-icon flex-shrink-0 w-6 h-6 rounded-full border border-rose-gold/30 flex items-center justify-center text-rose-gold">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
            </span>
          </button>
          <div class="accordion-content">
            <p class="px-5 sm:px-6 pb-5 sm:pb-6 font-body font-normal text-sm text-deep leading-relaxed">{f.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.faq-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const isOpen = item?.classList.contains('accordion-open');
      // Close all
      document.querySelectorAll('.faq-item').forEach(el => el.classList.remove('accordion-open'));
      // Toggle current
      if (!isOpen) item?.classList.add('accordion-open');
    });
  });
</script>
