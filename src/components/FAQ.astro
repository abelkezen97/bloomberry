---
const faqs = [
  {
    question: "Do you offer same-day flower delivery in Dubai and the UAE?",
    answer: "Yes, we provide complimentary temperature-controlled same-day delivery throughout Dubai, Sharjah, and Ajman for all orders placed before 4:00 PM. For Abu Dhabi and other Emirates, next-day white-glove delivery is standard."
  },
  {
    question: "Can I customize a luxury gifting hamper or floral box?",
    answer: "Absolutely. Bloom & Berry specializes in bespoke custom hampers. You can personalize your selection with custom gold-leaf monogramming, elite organic sweets, bespoke floral styling, and specific corporate or personal motifs. Contact our concierge via WhatsApp to coordinate."
  },
  {
    question: "How long do your premium floral arrangements remain fresh?",
    answer: "Our master floral designers arrange every bouquet using premium moisture-locking floral gels and specialized vertical transport frames. With gentle watering, our Ecuadorian roses and fresh phalaenopsis orchids generally remain pristine for 5 to 7 days."
  },
  {
    question: "Do you accommodate corporate gifting and large-scale event orders?",
    answer: "Yes. Our corporate concierge offers dedicated custom branding, hot-stamped leather embossing, customized packaging, and white-glove logistics for VIP clients, milestones, and high-end brand partnerships across the UAE."
  },
  {
    question: "How are orders processed and delivered?",
    answer: "To maintain the highest level of boutique service, all orders are coordinated directly via our WhatsApp Concierge (+971 55 367 0255). This allows us to confirm exact custom details, personal messages with hand-sealed wax, and precise delivery windows for every recipient."
  }
];
---
<section id="faq" class="w-full bg-white py-16 sm:py-20 lg:py-24 border-b border-gray-100">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Editorial Header -->
    <div class="text-center mb-12 sm:mb-16">
      <span class="text-[9px] tracking-[0.25em] uppercase font-body text-[#BF866E] font-semibold block mb-2">Concierge Assistant</span>
      <h2 class="font-heading text-xl sm:text-2xl tracking-[0.2em] text-[#3D2E27] uppercase font-medium">
        Frequently Asked Questions
      </h2>
    </div>

    <!-- Accordion Wrapper -->
    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <div class="border-b border-gray-100 pb-4">
          <button 
            type="button"
            class="faq-trigger w-full flex items-center justify-between py-4 text-left font-heading text-sm sm:text-base text-[#3D2E27] hover:text-[#BF866E] transition-colors focus:outline-none"
            data-index={index}
          >
            <span>{faq.question}</span>
            <svg class="w-4 h-4 text-gray-400 transition-transform duration-300 transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          
          <div class="faq-content hidden max-h-0 overflow-hidden transition-all duration-300 ease-out">
            <p class="font-body font-normal text-xs sm:text-sm text-gray-700 leading-relaxed pt-2 pb-4 pr-6">
              {faq.answer}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  // Dynamic smooth toggle for luxury FAQ accordions
  const triggers = document.querySelectorAll('.faq-trigger');
  
  triggers.forEach(trigger => {
    trigger.addEventListener('click', () => {
      const content = trigger.nextElementSibling as HTMLElement;
      const icon = trigger.querySelector('svg');
      
      // Toggle visibility
      const isOpen = !content.classList.contains('hidden');
      
      // Close all other FAQs first for premium clean focus
      document.querySelectorAll('.faq-content').forEach(c => {
        c.classList.add('hidden');
        c.style.maxHeight = '0px';
      });
      document.querySelectorAll('.faq-trigger svg').forEach(svg => {
        svg.classList.remove('rotate-180');
      });
      
      if (!isOpen) {
        content.classList.remove('hidden');
        content.style.maxHeight = content.scrollHeight + 'px';
        icon?.classList.add('rotate-180');
      } else {
        content.classList.add('hidden');
        content.style.maxHeight = '0px';
        icon?.classList.remove('rotate-180');
      }
    });
  });
</script>
