---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Collections from '../components/Collections.astro';
import WhyUs from '../components/WhyUs.astro';
import Bestsellers from '../components/Bestsellers.astro';
import FestiveShowcase from '../components/FestiveShowcase.astro';
import Occasions from '../components/Occasions.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
---

<Layout
  title="Bloom & Berry — Premium Gifting, Timeless Moments | Dubai UAE"
  description="Discover luxury hampers, premium flower bouquets, and bespoke gifting experiences in the UAE. Same-day delivery in Dubai & Abu Dhabi. Order on WhatsApp."
>
  <Header />
  <main>
    <Hero />
    <Collections />
    <WhyUs />
    <Bestsellers />
    <FestiveShowcase />
    <Occasions />
  </main>
  <Footer />
  <WhatsApp />
</Layout>
