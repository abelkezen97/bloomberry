---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { collections, products } from '../../data/catalog.js';

export function getStaticPaths() {
  return collections.map(col => ({
    params: { collection: col.id },
    props: { currentCollection: col }
  }));
}

const { currentCollection } = Astro.props;

// Filter products based on collection
const filteredProducts = currentCollection.id === 'all' 
  ? products 
  : products.filter(p => p.collection === currentCollection.id);

const whatsappNumber = '971501234567';
---

<Layout 
  title={`${currentCollection.title} | Bloom & Berry Luxury Gifting`}
  description={currentCollection.description}
>
  <Header />

  <main class="bg-[#FEF9F6] min-h-screen">
    
    <!-- EDITORIAL COLLECTION HEADER (Warm Ivory & Sophisticated Spacing) -->
    <section class="w-full bg-[#FAF4EF] py-16 sm:py-20 lg:py-24 border-b border-gray-100/50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <!-- Breadcrumbs -->
        <div class="flex justify-center items-center gap-2 text-[10px] tracking-[0.2em] uppercase font-body text-gray-600 mb-6">
          <a href="/" class="hover:text-[#BF866E] transition-colors">Home</a>
          <span>/</span>
          <span class="text-gray-700">Collections</span>
          <span>/</span>
          <span class="text-gray-800 font-medium">{currentCollection.title}</span>
        </div>

        <!-- Collection Title -->
        <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl text-[#3D2E27] uppercase tracking-wide mb-6 font-medium">
          {currentCollection.title}
        </h1>
        
        <!-- Collection Description -->
        <p class="font-body font-normal text-sm sm:text-base text-gray-700 max-w-xl mx-auto leading-relaxed">
          {currentCollection.description}
        </p>

        <!-- Quick Info stats -->
        <div class="mt-8 flex justify-center items-center gap-6 text-[10px] sm:text-xs tracking-[0.15em] font-body text-gray-700 font-normal">
          <span>{filteredProducts.length} EXQUISITE ITEMS</span>
        </div>
      </div>
    </section>

    <!-- PRODUCT CATALOG LISTING (Spacious, Luxury Grid Layout) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
      
      {filteredProducts.length === 0 ? (
        <div class="text-center py-20 bg-white border border-gray-100 rounded-sm">
          <p class="font-heading text-lg text-gray-700 uppercase tracking-widest mb-4">No arrangements available</p>
          <p class="font-body text-sm text-gray-600 max-w-xs mx-auto mb-8 font-normal">We are hand-crafting new designs. Chat with our studio directly for custom requests.</p>
          <a href={`https://wa.me/${whatsappNumber}`} class="inline-flex justify-center bg-[#BF866E] text-white text-xs font-body tracking-[0.2em] uppercase px-8 py-3.5 rounded-sm hover:bg-[#A8684F] transition-colors">
            CONTACT CONCIERGE
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-16 sm:gap-x-8">
          {filteredProducts.map(p => {
            const orderMsg = encodeURIComponent(`Hi Bloom & Berry, I would like to order the "${p.title}" (${p.price}) from your "${currentCollection.title}" collection. Can we coordinate delivery?`);
            
            return (
              <div class="group flex flex-col relative bg-white border border-gray-50/50 p-3 sm:p-4 rounded-sm shadow-[0_2px_8px_rgba(0,0,0,0.01)] hover:shadow-[0_8px_20px_rgba(0,0,0,0.03)] transition-all duration-300">
                
                <!-- Symmetrical Aspect Ratio Image with Zoom Effect -->
                <div class="relative overflow-hidden aspect-[4/5] bg-gray-50 rounded-sm mb-5">
                  <a href={`/products/${p.id}`}>
                    <img 
                      src={p.image} 
                      alt={p.title} 
                      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-103" 
                      loading="lazy" 
                    />
                  </a>
                </div>

                <!-- Product Text Details -->
                <div class="flex-1 flex flex-col">
                  <!-- Title -->
                  <h3 class="font-body text-xs sm:text-sm font-medium text-gray-800 hover:text-[#BF866E] transition-colors line-clamp-2 min-h-[32px] sm:min-h-[40px]">
                    <a href={`/products/${p.id}`}>{p.title}</a>
                  </h3>

                  <!-- Star Rating -->
                  <div class="flex items-center gap-1 mt-1.5 mb-2">
                    <div class="flex text-[#BF866E] gap-0.5">
                      {[...Array(p.rating)].map(() => (
                        <svg class="w-3 h-3 fill-current" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                    <span class="font-body text-[9px] text-gray-600 font-normal">({p.reviews})</span>
                  </div>

                  <!-- Price Tag -->
                  <span class="font-body text-xs sm:text-sm font-semibold text-gray-700 mb-5">
                    {p.price}
                  </span>

                  <!-- Action Buttons Stack (WhatsApp Primary, Details Secondary) -->
                  <div class="mt-auto space-y-2">
                    <a 
                      href={`https://wa.me/${whatsappNumber}?text=${orderMsg}`} 
                      target="_blank" 
                      rel="noopener"
                      class="w-full inline-flex items-center justify-center bg-[#BF866E] hover:bg-[#A8684F] text-white text-[10px] font-body tracking-[0.2em] uppercase py-3 transition-colors duration-300 rounded-sm font-normal"
                    >
                      ORDER VIA WHATSAPP
                    </a>
                    
                    <a 
                      href={`/products/${p.id}`}
                      class="w-full inline-flex items-center justify-center border border-gray-100 hover:border-gray-300 text-gray-700 hover:text-gray-900 text-[9px] font-body tracking-[0.2em] uppercase py-2 transition-all duration-300 rounded-sm bg-white"
                    >
                      VIEW DETAILS
                    </a>
                  </div>
                </div>

              </div>
            );
          })}
        </div>
      )}

    </section>

    <!-- PREMIUM REASSURANCE STRIP -->
    <section class="bg-white border-t border-b border-gray-100 py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
          <div class="flex flex-col items-center">
            <span class="font-heading text-xs tracking-[0.2em] uppercase text-gray-800 mb-2 font-medium">Bespoke Monograms</span>
            <p class="font-body text-[11px] font-normal text-gray-600 max-w-xs">Custom monogram hand-painting and gold-leaf stampings available upon request.</p>
          </div>
          <div class="flex flex-col items-center border-y border-gray-100 md:border-y-0 md:border-x py-6 md:py-0">
            <span class="font-heading text-xs tracking-[0.2em] uppercase text-gray-800 mb-2 font-medium">VIP White-Glove Fleet</span>
            <p class="font-body text-[11px] font-normal text-gray-600 max-w-xs">Arranged in temperature-controlled Sprinter vans for absolute floral perfection.</p>
          </div>
          <div class="flex flex-col items-center">
            <span class="font-heading text-xs tracking-[0.2em] uppercase text-gray-800 mb-2 font-medium">Direct Concierge</span>
            <p class="font-body text-[11px] font-normal text-gray-600 max-w-xs">Skip the forms. Co-create customized luxury gifting with our studio designers via WhatsApp.</p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
