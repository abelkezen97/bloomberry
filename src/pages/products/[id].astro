---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { products } from '../../data/catalog.js';

export function getStaticPaths() {
  return products.map(prod => ({
    params: { id: prod.id },
    props: { p: prod }
  }));
}

const { p } = Astro.props;

// Filter related products (same category or top rated, excluding current product)
const relatedProducts = products
  .filter(item => item.id !== p.id && (item.collection === p.collection || item.rating === 5))
  .slice(0, 4);

const whatsappNumber = '971553670255';

// Generate WhatsApp order link
const defaultMsg = encodeURIComponent(`Hi Bloom & Berry, I would like to order the "${p.title}" (${p.price}). Can we coordinate delivery details?`);
---

<Layout 
  title={`${p.title} | Bloom & Berry Dubai`}
  description={p.description}
>
  <Header />

  <main class="bg-[#FEF9F6] min-h-screen py-10 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- BREADCRUMBS -->
      <nav class="flex items-center gap-2 text-[10px] tracking-[0.2em] uppercase font-body text-gray-600 mb-8 sm:mb-12" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#BF866E] transition-colors">Home</a>
        <span>/</span>
        <a href={`/collections/${p.collection}`} class="hover:text-[#BF866E] transition-colors capitalize">{p.collection}</a>
        <span>/</span>
        <span class="text-gray-800 font-medium truncate">{p.title}</span>
      </nav>

      <!-- 2-COLUMN LUXURY LAYOUT (Image left, Sticky details right) -->
      <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-16 items-start">
        
        <!-- COLUMN 1: PORTRAIT IMAGE COMPOSITE -->
        <div class="relative w-full aspect-[4/5] bg-white border border-gray-100 p-4 rounded-sm shadow-[0_4px_24px_rgba(0,0,0,0.02)]">
          <img 
            src={p.image} 
            alt={p.title} 
            class="w-full h-full object-cover rounded-sm transition-transform duration-700 hover:scale-102"
            loading="eager"
          />
          <span class="absolute top-8 left-8 bg-[#FAF4EF] text-gray-700 text-[9px] tracking-[0.2em] uppercase font-body px-4 py-2 border border-gray-100 rounded-sm font-medium">
            ARTISAN QUALITY
          </span>
        </div>

        <!-- COLUMN 2: EDITORIAL DETAILS PANEL (Sticky) -->
        <div class="lg:sticky lg:top-24 space-y-8">
          
          <!-- Title & Badging -->
          <div>
            <span class="text-[9px] tracking-[0.25em] uppercase font-body text-[#BF866E] font-medium block mb-2">Signature Curation</span>
            <h1 class="font-heading text-2xl sm:text-3xl lg:text-4xl text-[#3D2E27] font-medium leading-[1.2] uppercase tracking-wide">
              {p.title}
            </h1>
            
            <!-- Price and Star Rating -->
            <div class="flex items-center justify-between mt-4 pb-4 border-b border-gray-100">
              <span class="font-body text-lg sm:text-xl font-semibold text-gray-800">
                {p.price}
              </span>

              <div class="flex items-center gap-1.5">
                <div class="flex text-[#BF866E] gap-0.5">
                  {[...Array(5)].map(() => (
                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
                <span class="font-body text-[10px] sm:text-xs text-gray-600 font-normal">({p.reviews} verified reviews)</span>
              </div>
            </div>
          </div>

          <!-- Tagline & Description -->
          <div class="space-y-3">
            <p class="font-heading italic font-normal text-sm sm:text-base text-[#BF866E]">
              "{p.tagline}"
            </p>
            <p class="font-body font-normal text-xs sm:text-sm text-gray-700 leading-relaxed">
              {p.description}
            </p>
          </div>

          <!-- Luxe Custom options (Interactive Selection Mock) -->
          <div class="space-y-3">
            <span class="text-[9px] tracking-[0.2em] uppercase font-body text-gray-600 block font-semibold">Select Arrangement Tier</span>
            <div class="grid grid-cols-3 gap-3">
              <button class="border border-[#BF866E] bg-white text-gray-800 text-[10px] tracking-widest font-body uppercase py-3 rounded-sm font-medium focus:outline-none">
                Standard
              </button>
              <button class="border border-gray-200 hover:border-[#BF866E] bg-white text-gray-600 hover:text-gray-800 text-[10px] tracking-widest font-body uppercase py-3 rounded-sm transition-all focus:outline-none">
                Prestige
              </button>
              <button class="border border-gray-200 hover:border-[#BF866E] bg-white text-gray-600 hover:text-gray-800 text-[10px] tracking-widest font-body uppercase py-3 rounded-sm transition-all focus:outline-none">
                Royal
              </button>
            </div>
          </div>

          <!-- PRIMARY WHATSAPP ACTION BLOCK -->
          <div class="bg-white border border-gray-100 p-5 sm:p-6 rounded-sm shadow-[0_6px_20px_rgba(0,0,0,0.01)] space-y-4">
            <a 
              href={`https://wa.me/${whatsappNumber}?text=${defaultMsg}`}
              target="_blank"
              rel="noopener"
              id="whatsapp-order-btn"
              class="w-full inline-flex items-center justify-center bg-[#BF866E] hover:bg-[#A8684F] text-white text-xs font-body tracking-[0.2em] uppercase py-4 transition-colors duration-300 shadow-sm rounded-sm font-medium"
            >
              ORDER VIA WHATSAPP
            </a>
            
            <div class="flex items-center justify-center gap-2 text-[10px] tracking-[0.1em] font-body text-gray-600 font-normal text-center">
              <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-ping"></span>
              <span>Available now. Click to co-coordinate direct VIP courier delivery.</span>
            </div>
          </div>

          <!-- ACCORDION DETAILS (CSS-Only smooth summary details) -->
          <div class="border-t border-gray-100 pt-6 space-y-4">
            
            <details class="group border-b border-gray-100 pb-4" open>
              <summary class="flex justify-between items-center font-heading text-xs tracking-[0.2em] uppercase text-gray-800 cursor-pointer list-none select-none font-medium">
                <span>Composition & Stems</span>
                <span class="transition-transform duration-300 group-open:rotate-180">
                  <svg class="w-3.5 h-3.5 text-gray-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                </span>
              </summary>
              <div class="mt-3 pl-1">
                <ul class="space-y-1.5">
                  {p.details.map(item => (
                    <li class="font-body font-normal text-xs text-gray-700 flex items-start gap-2.5 leading-relaxed">
                      <span class="text-[#BF866E] text-sm mt-[-2px]">•</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </details>

            <details class="group border-b border-gray-100 pb-4">
              <summary class="flex justify-between items-center font-heading text-xs tracking-[0.2em] uppercase text-gray-800 cursor-pointer list-none select-none font-medium">
                <span>The Art of Gifting</span>
                <span class="transition-transform duration-300 group-open:rotate-180">
                  <svg class="w-3.5 h-3.5 text-gray-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                </span>
              </summary>
              <div class="mt-3 pl-1">
                <p class="font-body font-normal text-xs text-gray-700 leading-relaxed">
                  {p.packaging}
                </p>
              </div>
            </details>

            <details class="group border-b border-gray-100 pb-4">
              <summary class="flex justify-between items-center font-heading text-xs tracking-[0.2em] uppercase text-gray-800 cursor-pointer list-none select-none font-medium">
                <span>VIP Logistics & Delivery</span>
                <span class="transition-transform duration-300 group-open:rotate-180">
                  <svg class="w-3.5 h-3.5 text-gray-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                  </svg>
                </span>
              </summary>
              <div class="mt-3 pl-1">
                <p class="font-body font-normal text-xs text-gray-700 leading-relaxed">
                  {p.delivery}
                </p>
              </div>
            </details>

          </div>

        </div>

      </div>

      <!-- YOU MAY ALSO LOVE (Related products) -->
      <section class="mt-24 pt-16 border-t border-gray-100">
        <div class="text-center mb-12 sm:mb-16">
          <span class="text-[9px] tracking-[0.25em] uppercase font-body text-[#BF866E] font-medium block mb-2">Curated Pairings</span>
          <h2 class="font-heading text-xl sm:text-2xl tracking-[0.2em] text-[#3D2E27] uppercase font-medium">
            You May Also Love
          </h2>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-12 sm:gap-x-8">
          {relatedProducts.map(rp => {
            const rpMsg = encodeURIComponent(`Hi Bloom & Berry, I would like to order the "${rp.title}" (${rp.price}). Can we coordinate delivery?`);
            return (
              <div class="group flex flex-col bg-white p-3 rounded-sm shadow-[0_2px_8px_rgba(0,0,0,0.01)] border border-gray-50/50">
                <div class="relative overflow-hidden aspect-[4/5] bg-gray-50 rounded-sm mb-4">
                  <a href={`/products/${rp.id}`}>
                    <img 
                      src={rp.image} 
                      alt={rp.title} 
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-103" 
                      loading="lazy" 
                    />
                  </a>
                </div>

                <h3 class="font-body text-xs sm:text-sm font-medium text-gray-800 hover:text-[#BF866E] transition-colors line-clamp-2 min-h-[32px] sm:min-h-[40px]">
                  <a href={`/products/${rp.id}`}>{rp.title}</a>
                </h3>

                <span class="font-body text-xs sm:text-sm text-gray-700 mt-1 font-semibold block mb-4">
                  {rp.price}
                </span>

                <a 
                  href={`https://wa.me/${whatsappNumber}?text=${rpMsg}`}
                  target="_blank"
                  rel="noopener"
                  class="w-full text-center bg-[#BF866E] hover:bg-[#A8684F] text-white text-[9px] sm:text-[10px] font-body tracking-[0.05em] sm:tracking-[0.2em] uppercase py-2.5 transition-colors duration-300 rounded-sm font-semibold whitespace-nowrap px-1"
                >
                  ORDER NOW
                </a>
              </div>
            );
          })}
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>

<script define:vars={{ whatsappNumber, title: p.title, price: p.price }}>
  // Option Tiers interactive listener
  const buttons = document.querySelectorAll('button[class*="Select Arrangement Tier"] ~ div button');
  const orderBtn = document.getElementById('whatsapp-order-btn');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      // Remove border styling of all buttons
      buttons.forEach(b => {
        b.classList.remove('border-[#BF866E]', 'text-gray-800');
        b.classList.add('border-gray-200', 'text-gray-600');
      });

      // Add active styling to clicked
      btn.classList.remove('border-gray-200', 'text-gray-600');
      btn.classList.add('border-[#BF866E]', 'text-gray-800');

      // Update WhatsApp link message based on selected tier
      const selectedTier = btn.textContent.trim();
      const updatedMsg = encodeURIComponent(`Hi Bloom & Berry, I would like to order the "${title}" (${price}, Tier: ${selectedTier}). Can we coordinate delivery details?`);
      
      if (orderBtn) {
        orderBtn.setAttribute('href', `https://wa.me/${whatsappNumber}?text=${updatedMsg}`);
      }
    });
  });
</script>
